# Blog app environment
# These are the runtime variables the prebuilt Docker image expects in production.
# The image also accepts the legacy LISTMONK_*/SITE_* names below and maps them
# to Nuxt runtime config on container startup.
NUXT_LISTMONK_URL=http://ccfreiburg.lists.app:9000
NUXT_LISTMONK_API_USER=your_api_username
NUXT_LISTMONK_API_TOKEN=your_api_token_here
NUXT_PUBLIC_SITE_URL=https://blog.example.com
NUXT_PUBLIC_SITE_NAME=CCFreiburg Blog
NUXT_PUBLIC_SITE_DESCRIPTION=News and updates from CCFreiburg.
NUXT_PUBLIC_AUTHOR_NAME=Pastor Alex Röhm
NUXT_PUBLIC_AUTHOR_ROLE=Calvary Chapel Freiburg, Germany
NUXT_PUBLIC_AUTHOR_AVATAR_URL=https://lists.ccfreiburg.de/uploads/aravatar.png
NUXT_PUBLIC_HERO_IMAGE_URL=https://lists.ccfreiburg.de/uploads/hero.jpg